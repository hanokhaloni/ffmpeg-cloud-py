{
  "reportDirectory": "reports",
  "ffmpeg": {
    "executable": "ffmpeg",
    "ffprobe": "ffprobe",
    "logLevel": "info",
    "processStallTimeoutSeconds": 10,
    "startupTimeoutSeconds": 30
  },
  "source": {
    "url": "synthetic",
    "transport": "tcp",
    "expectedFps": 25,
    "useReadrate": false
  },
  "storage": {
    "hlsDirectory": "out/hls",
    "recordingDirectory": "out/rec",
    "minimumFreeSpaceGb": 10,
    "smallFileCount": 50,
    "segmentFileCount": 10,
    "segmentFileSizeMb": 4,
    "latencyWarnMs": 250,
    "latencyFailMs": 1000
  },
  "hls": {
    "enabled": true,
    "targetDurationSeconds": 2,
    "playlistSize": 3,
    "durationToleranceSeconds": 0.5,
    "maxSegmentAgeSeconds": 8,
    "minSegmentSizeBytes": 1024,
    "decodeSegments": true,
    "flags": "delete_segments+independent_segments",
    "deleteThreshold": 6,
    "playlistName": "stream.m3u8",
    "playbackTest": true,
    "httpUrl": ""
  },
  "recording": {
    "enabled": true,
    "segmentDurationSeconds": 5,
    "mode": "faststart",
    "fullDecode": true,
    "stableSeconds": 1.5,
    "durationToleranceSeconds": 1.5,
    "seekProbes": 3
  },
  "time": {
    "enabled": false,
    "ntpServer": "pool.ntp.org",
    "sampleCount": 5,
    "maxClockDifferenceMs": 500,
    "onvifUrl": ""
  },
  "benchmark": {
    "durationSeconds": 3600,
    "profile": "baseline",
    "concurrentStreams": 1,
    "injectKillAtSeconds": 0
  },
  "lab": {
    "preset": "local-4-streams",
    "durationSeconds": 600,
    "failFast": false,
    "runRoot": "streambench-runs",
    "relay": {
      "mode": "managed",
      "executable": ".\\tools\\mediamtx\\mediamtx.exe",
      "listenAddress": "127.0.0.1",
      "rtspPort": 8554,
      "rtpPort": 8000,
      "rtcpPort": 8001,
      "apiPort": 9997,
      "url": "",
      "readyTimeoutSeconds": 15
    },
    "publishers": {
      "count": 4,
      "mode": "loop-file",
      "fixturePreset": "720p25-h264-aac",
      "fixtureDirectory": "streambench-fixtures",
      "fixtureDurationSeconds": 60,
      "pathTemplate": "s{index:00}",
      "startupTimeoutSeconds": 30,
      "transport": "tcp"
    },
    "consumers": {
      "instancesPerSource": 1,
      "profiles": [
        "dual-copy"
      ],
      "execution": "parallel",
      "staggerMilliseconds": 500,
      "groupDurationSeconds": 0,
      "stages": [],
      "stageDurationSeconds": 0,
      "injectRtspTimeout": true
    },
    "http": {
      "enabled": true,
      "listenAddress": "127.0.0.1",
      "port": 8088
    },
    "shutdown": {
      "gracefulTimeoutSeconds": 15,
      "preserveOutputs": true
    },
    "validation": {
      "maxDecodeWorkers": 0,
      "recordingHttpSampleEvery": 3,
      "livePlayer": true,
      "firstOutputTimeoutSeconds": 40
    },
    "sources": [],
    "templates": [],
    "faults": []
  },
  "ui": {
    "mode": "full-screen",
    "refreshHz": 4,
    "historySeconds": 300,
    "theme": "dark",
    "showCommand": true,
    "asciiFallback": "auto",
    "color": true
  },
  "executables": {
    "ffmpeg-current": "ffmpeg"
  }
}